rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    // Verificamos el rol directamente desde Firestore (Cross-Service Rules)
    function isInternalTeam() {
      return isAuthenticated() && 
             firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data.rol in ['Administrador', 'Analista', 'Mesa', 'Administracion'];
    }

    // Bloqueamos TODO por defecto
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // 📁 CARPETA: cvs
    match /cvs/{fileName} {
      // Leer: Todos los usuarios logueados pueden ver el CV
      allow read: if isAuthenticated();
      
      // Crear (Subir): Solo logueados, máximo 5MB, y solo PDF o Imágenes
      allow create: if isAuthenticated() 
                    && request.resource.size < 5 * 1024 * 1024 // 5 MB de límite
                    && request.resource.contentType.matches('application/pdf|image/.*');
      
      // No permitimos actualizar ni borrar CVs desde el cliente (solo por consola de Firebase)
      allow update, delete: if false; 
    }

    // 📁 CARPETA: fotos (Preparando el terreno para nuestra galería)
    match /fotos/{fileName} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() 
                    && request.resource.size < 5 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');
    }

    // 📁 CARPETA: estudios
    match /estudios/{solicitudId}/{fileName} {
    
      // Lectura:
      // - Equipo interno: acceso completo.
      // - Cliente: solo si pertenece a la empresa de la solicitud.
      allow read: if isInternalTeam() ||
        (
          isAuthenticated() &&
          firestore.get(
            /databases/(default)/documents/solicitudes/$(solicitudId)
          ).data.get('empresa', '') ==
          firestore.get(
            /databases/(default)/documents/usuarios/$(request.auth.uid)
          ).data.get('empresa', '')
        );
    
      // Solo usuarios del equipo interno pueden subir evidencias.
      allow create: if isInternalTeam()
                    && request.resource.size < 5 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');
    
      // Solo el equipo interno puede eliminar evidencias.
      allow delete: if isInternalTeam();
    }
  }
}
